# Google Gemini (free tier) - https://ai.google.dev
GEMINI_API_KEY=
# Verify the current free-tier model name at ai.google.dev before relying on the default.
GEMINI_MODEL=gemini-flash-latest

# Meta Graph API (Instagram + Facebook Page Reels) - needs app review for
# instagram_content_publish and pages_manage_posts. Use a Page access token.
IG_USER_ID=
FB_PAGE_ID=
META_ACCESS_TOKEN=
# Check developers.facebook.com for the current API version before relying on the default.
GRAPH_API_VERSION=v25.0

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: override the News Catcher's RSS feeds (comma-separated). Leave commented out to use
# the defaults: SEBI, ET Markets, Mint Markets, Business Standard Markets.
# RSS_FEEDS=

# NSE's internal JSON endpoint for provisional FII/DII cash-market activity
NSE_FII_DII_URL=https://www.nseindia.com/api/fiidiiTradeReact

# News-card backgrounds are generated locally; optionally drop your own .jpg/.png photos into assets/backgrounds/


# Generated cards/reels older than this many days are deleted daily at 03:30 IST
MEDIA_RETENTION_DAYS=7

# Max Reels posted to Instagram/Facebook per day (Facebook allows 30 API posts per 24h)
MAX_REELS_PER_DAY=25

# News pacing: posting window (IST hours), posts per 30-min check, max item age
NEWS_WINDOW_START_HOUR=6
NEWS_WINDOW_END_HOUR=23
MAX_NEWS_PER_RUN=1
NEWS_MAX_AGE_HOURS=12

# Set true only if this network has broken IPv6 (connections hang before falling back to IPv4)
FORCE_IPV4=false

# Handle shown on Telegram cards and on Instagram/Facebook Reels
CARD_HANDLE=@wealthandworkflow
REEL_HANDLE=@marketsketchbook

# Your private chat ID with the bot (not the channel) for maintenance alerts such as the Meta token reminder
ADMIN_CHAT_ID=
META_TOKEN_WARN_DAYS=14
